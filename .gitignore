# Nested git from cloned repo (track files, not their git history)
C64_MiSTer/.git/

# Quartus build artifacts
C64_MiSTer/output_files/
C64_MiSTer/db/
C64_MiSTer/incremental_db/
C64_MiSTer/simulation/
C64_MiSTer/greybox_tmp/
C64_MiSTer/*.qws
C64_MiSTer/C64_assignment_defaults.qdf
C64_MiSTer/build_id.v

# Generated PLL databases
C64_MiSTer/rtl/pll/pll_0002.ppf
C64_MiSTer/sys/pll_hdmi/pll_hdmi_0002.ppf
C64_MiSTer/sys/pll_audio/pll_audio_0002.ppf

# Build output copied to root
*.rbf
*.sof

# Build archive: track INDEX.md + per-build .json metadata, but the .rbf
# binaries are large (~4 MB each) and stay local-only. tools/archive_rbf.py
# writes them to C64_MiSTer/builds/.
C64_MiSTer/builds/*.rbf
!C64_MiSTer/builds/INDEX.md
!C64_MiSTer/builds/*.json
!C64_MiSTer/builds/README.md

# Test cartridge build output (regenerated by gen_*.py scripts)
tools/test_cart/out/

# Editor/IDE
*.bak
*.swp
*~
.vscode/

# Local scratch/debug tooling artifacts
.abacusai/
C64_MiSTer/signalprobe_qsf.tcl

# Claude Code session data
.claude/

# Reference repos (not part of this project)
SNES_MiSTer/
external/vice-svn-mirror/
external/65816/

# SST harness sweep logs (regenerated by sweep_sst.ps1).
# Covers sweep_results/, sweep_results_v3/, sweep_results_dpx/, etc.
sim/p65c816_singlesteptest/sweep_results*/

# Old manually-placed CRT artifacts (use tools/test_cart/ generators instead)
crt/

# Screenshots / temp files
mister_screen.png

# Debug captures dropped in repo root (screenshots, build logs, UART
# traces, raw config dumps, cached rbf builds — both hidden ".name"
# and visible "name" forms). Tracked screenshots live in screenshots/.
/.*.png
/.*.log
/.*.uart
/.*.bin
/.*.rbf
/*.png
/*.log
/*.uart
/*.bin

# Tools directory drops the same debug artifacts during runs
tools/*.png
tools/*.log
tools/*.uart
tools/vice_*.bin
tools/vice_diff/*.log
tools/vice_diff/*.raw_chunks.log

# Old UART captures with various Doom debug suffixes
/uart_*.log.*

# Build helper temp files (no extension, dropped during scripted builds)
/.current_build_log
/.current_build_err

# SCPU library sweep CSV outputs (regenerable from tools/scpu_library_sweep.py)
/logs/

# Historical per-version DL screenshot dirs (v200..v258 etc.) — superseded
# by tools/dl_screens_v272_scpu/ which is the post-fix evidence.
tools/dl_screens_*/
!tools/dl_screens_v272_scpu/

# Historical per-session UART captures — keep tools/dl_uart_baseline_v272_*
# as v272 fix evidence. Earlier baselines are superseded.
tools/dl_uart_scpu_*.txt
tools/dl_uart_t65_*.txt
tools/dl_uart_baseline_*/
!tools/dl_uart_baseline_v272_*/

# v272 sweep intermediate outputs (regenerable from tools/v272_sweep*.py).
# Keep tools/v272_sweep2/ for the DL/asterix-on-SCPU screenshot evidence
# referenced from the v272 memory notes.
tools/v272_regress/
tools/v272_sweep/
!tools/v272_sweep2/

# Local-only large game asset dump (16 MB REU; not source).
dlair_assets/
tools/dl00.reu

# Per-version DL triage screenshot dumps from v200..v258 era — superseded
# by v272 fix evidence under tools/dl_screens_v272_scpu/.
docs/dl_triage/

# GHDL/sim work directories (compile cache, not source)
sim/**/work/
sim/**/work_*/
C64_MiSTer/work-obj08.cf

# Verilator build artifacts and run logs (regenerated by build)
sim/verilator_c64_vanilla/obj_dir/
sim/verilator_c64_vanilla/*.log
sim/verilator_c64_vanilla/flow/generated/
sim/verilator_c64_vanilla/flow/build_staging/
# Symlink to upstream ROM dir — recreated by the Verilator setup script;
# absolute WSL path which Windows-native git can't index anyway.
sim/verilator_c64_vanilla/rtl/roms

# Python bytecode cache
tools/__pycache__/
**/__pycache__/

# Quartus IDE-generated tracking JSON
C64_MiSTer/cr_ie_info.json

# Root-level debug PRGs / disk images / dumps (regenerable from tools/)
/*.prg
/*.mgl
/*.s
/*.d2m
/*.cmd
/*.cfg
/*.cf
/*.bas
/*.diff
/*.json
/*.zip
!/scpukicksd64.zip

# Root-level version-tagged debug artifacts
/v[0-9]*_*.txt

# Other root-level transient debug captures
/*_uart.txt
/*_tr.txt
/*_uart_capture.txt
/test_*.txt
/test_mtype_*.txt

# Scratch session notes (real docs use uppercase or live in docs/)
/progress.md
/task_plan.md
/findings.md
/readme.txt

# Local assembled object files
*.o

# Loose top-level disk images / REU dumps (downloaded artifacts; not source)
/*.D64
/*.d64
/*.reu

# cocotb verification environment — ignore venv, build dir, run logs, binary
sim/cocotb/.venv/
sim/cocotb/sim_build/
sim/cocotb/results.xml
sim/cocotb/p65c816
sim/cocotb/*.log
sim/cocotb/.tmp_*

# VICE oracle gameplay snapshot artifact (~9 MB, regenerable via
# tools/vice_dump_gameplay_state.py --warp-secs 90)
tools/vice_oracle/gameplay/

# GHDL compat sweep transient outputs (regenerable via tools/ghdl_compat_sweep.ps1)
tools/ghdl_sweep_logs/
tools/ghdl_compat_sweep_results.txt
tools/_scpu_disks/
